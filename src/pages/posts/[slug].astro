---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostSlug } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.published !== false);
  posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const cats = post.data.category || [];
const tags = post.data.tags || [];

const currentIdx = posts.findIndex((p) => p.id === post.id);
const prevPost = currentIdx > 0 ? posts[currentIdx - 1] : null;
const nextPost = currentIdx < posts.length - 1 ? posts[currentIdx + 1] : null;

const { Content, headings } = await post.render();
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article id="post">
    <div id="post-main">
      <div class="post-header" style="position:relative;">
        <h1 id="post-title">{post.data.title}</h1>
        <div id="post-toc-inline">
          <div id="toc" class="toc-article">
            <div class="toc-title">
              <div class="toc-title-bar">
                <span>目录</span>
                <a class="toc-toggle" href="#" title="展开">[-]</a>
                <div class="reading-progress"><div class="reading-progress-text">0%</div></div>
              </div>
            </div>
            {tocHeadings.length > 0 && (
              <ol class="toc-list">
                {tocHeadings.map(h => (
                  <li class={`toc-item toc-depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      </div>
      <div id="post-date" class="d-flex flex-row" style="display:flex;flex-wrap:wrap;align-items:center;gap:0.3rem;margin-bottom:0.4rem;">
        <span class="post-meta-label">创建:</span>
        <span class="post-meta-value">{post.data.date.toISOString().slice(0,10)}</span>
        <span class="post-meta-label">更新:</span>
        <span class="post-meta-value">{post.data.updated ? post.data.updated.toISOString().slice(0,10) : post.data.date.toISOString().slice(0,10)}</span>
        <span class="post-meta-label">字数:</span>
        <span id="post-count-body"><span class="post-meta-value"><a href="javascript:initWordCountOnly()">0</a> <span>字</span></span></span>
        <span class="post-meta-label">耗时:</span>
        <span id="post-time-body"><span class="post-meta-value"><a href="javascript:initReadingTimeOnly()">0</a> <span>分钟</span></span></span>
      </div>
      <div id="post-cate-tag" class="d-flex flex-row" style="display:flex;flex-wrap:wrap;align-items:center;gap:0.3rem;margin-bottom:0.4rem;">
        <span class="post-meta-label">分类:</span>
        <span class="post-meta-value">{cats.join(', ')}</span>
        <span class="post-meta-label">标签:</span>
        <span class="post-meta-value">{tags.join(', ')}</span>
      </div>
      <hr />
    </div>
    <div class="scrollable-container">
      <div id="post-content">
        <Content />
        <hr />
        <div id="post-info">
          <div id="post-info-main">
            <div id="post-author"><span>文章作者: </span><p class="author-names">Wooxin</p></div>
            <div id="post-links"><span>文章链接: </span><p>{Astro.url.href}</p></div>
            <div id="post-copyright"><span>版权声明: </span><p class="copyright-names">CC BY-NC-SA 4.0</p></div>
          </div>
        </div>
        <hr />
        <div id="post-bottom">
          <div id="post-bottom-content">
            {nextPost && <div id="post-bottom-prev"><a href={`/posts/${getPostSlug(nextPost)}/`}>下一篇: {nextPost.data.title}</a></div>}
            {prevPost && <div id="post-bottom-next"><a href={`/posts/${getPostSlug(prevPost)}/`}>上一篇: {prevPost.data.title}</a></div>}
          </div>
        </div>
        <hr />
        <div id="post-comment">
          <div id="post-comment-main"></div>
        </div>
      </div>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "datePublished": post.data.date.toISOString().slice(0,10),
    "dateModified": (post.data.updated || post.data.date).toISOString().slice(0,10),
    "author": { "@type": "Person", "name": "Wooxin" }
  })} />

</BaseLayout>
