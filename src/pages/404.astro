---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面未找到">
  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;text-align:center;padding:2rem;">
    <h1 style="font-size:4rem;font-weight:700;color:var(--accent);margin:0;">404</h1>
    <p style="font-size:1.2rem;color:var(--text-secondary);margin:1rem 0;">抱歉，你访问的页面不存在</p>
    <a href="/" style="display:inline-block;padding:0.5rem 1.5rem;background:var(--accent);color:var(--accent-text);border-radius:0.5rem;text-decoration:none;font-weight:500;">返回首页</a>
  </div>
</BaseLayout>
