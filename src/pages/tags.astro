---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => data.published !== false);
const tagMap = new Map();
posts.forEach(p => {
  (p.data.tags || []).forEach(t => {
    if (!tagMap.has(t)) tagMap.set(t, []);
    tagMap.get(t).push(p);
  });
});
const tags = Array.from(tagMap.entries()).sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title="标签">
  <div id="tags" style="height:100vh;max-height:100vh;overflow-y:auto;padding:1.5rem;">
    <h1>标签</h1>
    <div class="tag-list" style="display:grid;grid-template-columns:repeat(6,1fr);gap:8px;list-style:none;padding:0;">
      {tags.map(([tag, tagPosts]) => (
        <div class="tag-list-item" style="margin:0.15rem;padding:0.35rem 0.75rem;display:flex;align-items:center;justify-content:center;background:var(--bg-surface);border:var(--border-subtle);border-radius:2rem;box-shadow:var(--shadow-sm);">
          <a class="tag-list-link" href={`/tags/${tag}/`} style="color:var(--text-link);text-decoration:none;font-size:0.82rem;">{tag}</a>
          <span style="font-size:0.7rem;color:var(--text-muted);margin-left:0.3rem;">({tagPosts.length})</span>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
